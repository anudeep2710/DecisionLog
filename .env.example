# Backend
# Use the connection string supplied by Neon; do not commit a real password.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:3000

# Optional SQLAlchemy pool tuning for a small Neon compute instance.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=300
