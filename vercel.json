{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/api",
      "dest": "/api/index.py?__vercel_path=/"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py?__vercel_path=/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py?__vercel_path=/$1"
    }
  ]
}
